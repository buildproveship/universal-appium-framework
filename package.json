{
  "name": "@releaseready/appium-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable native mobile E2E testing template with WebdriverIO, Cucumber, TypeScript, and Appium",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.4.2",
  "scripts": {
    "test:android": "wdio run ./wdio.android.conf.ts",
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "appium:drivers:android": "appium driver install uiautomator2",
    "appium:drivers:ios": "appium driver install xcuitest",
    "typecheck": "tsc --noEmit",
    "setup:check": "npm ls --all",
    "setup:check:android": "npm run setup:check && appium driver doctor uiautomator2",
    "setup:check:ios": "npm run setup:check && appium driver doctor xcuitest",
    "setup:check:app": "tsx scripts/check-app-path.ts",
    "test:smoke:offline": "node --import tsx --test tests/smoke/*.test.ts",
    "test:setup": "node --import tsx --test tests/setup/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:quality": "node --import tsx --test tests/quality/*.test.ts",
    "check:guardrails": "releaseready-guardrails",
    "check:offline": "npm run typecheck && npm run lint && npm run format:check && npm run check:guardrails && npm run test:quality && npm run test:setup && npm run test:smoke:offline"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "sharp": "0.35.5",
    "shell-quote": "1.12.0",
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@releaseready/config": "^3.0.0",
    "@types/node": "22.19.11",
    "@wdio/allure-reporter": "10.1.0",
    "@wdio/appium-service": "10.1.1",
    "@wdio/cli": "10.1.0",
    "@wdio/cucumber-framework": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "appium": "3.8.0",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "glob": "14.0.4",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "prettier": "@releaseready/config/prettier",
  "license": "Apache-2.0"
}
